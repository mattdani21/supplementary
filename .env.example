# Copy to .env for local development. Never commit a filled-in copy.

# Provider selection. `fake` is the deterministic offline provider set and is the default
# everywhere except staging and production. A real provider must be opted into explicitly.
GAPOS_PROVIDER_MODE=fake

# Postgres. Matches infra/local/docker-compose.yml.
DATABASE_URL=postgres://gapos:gapos@localhost:5432/gapos

# Set to run the database integration suite. Unset means those tests skip.
# GAPOS_TEST_DATABASE_URL=postgres://gapos:gapos@localhost:5432/gapos_test

# S3-compatible object storage. Matches the local MinIO service.
GAPOS_STORAGE_ENDPOINT=http://localhost:9000
GAPOS_STORAGE_BUCKET=gapos-local
GAPOS_STORAGE_ACCESS_KEY=gapos
GAPOS_STORAGE_SECRET_KEY=gapos-local-secret

# Budgets, in whole cents. Enforced before a provider call is made.
GAPOS_BUDGET_PER_RUN_CENTS=200
GAPOS_BUDGET_PER_USER_DAILY_CENTS=1000

# Real provider credentials. Leave empty unless GAPOS_PROVIDER_MODE is not `fake`.
# GAPOS_LLM_API_KEY=
# GAPOS_LLM_BASE_URL=https://api.deepseek.com
# GAPOS_LLM_MODEL=deepseek-chat
# Optional live-LLM pricing overrides, in millicents per million tokens.
# Defaults track deepseek-chat list prices ($0.27/M input, $1.10/M output).
# GAPOS_LLM_PRICE_INPUT_MILLICENTS_PER_MT=27000
# GAPOS_LLM_PRICE_OUTPUT_MILLICENTS_PER_MT=110000
# Live TTS uses the free Google Translate endpoint (no key needed). GAPOS_TTS_API_KEY is
# reserved for a paid provider behind the same engine interface (E17 provider routing).
# GAPOS_TTS_API_KEY=

# Identity. demo keeps X-Owner-Id for local/CI. protected requires Auth.js + AUTH_SECRET.
GAPOS_IDENTITY_MODE=demo
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# GAPOS_INVITE_SUBJECTS=learner@example.com

# Notebook proofs. protected mode defaults to disabled.
# GAPOS_PROOF_EXECUTION=local

# Authenticated request quotas (required with explicit values in protected mode).
# GAPOS_QUOTA_UPLOAD_LIMIT=30
# GAPOS_QUOTA_UPLOAD_WINDOW_MS=60000
# GAPOS_QUOTA_COMPILE_LIMIT=6
# GAPOS_QUOTA_COMPILE_WINDOW_MS=60000
# GAPOS_QUOTA_PROOF_LIMIT=40
# GAPOS_QUOTA_PROOF_WINDOW_MS=60000
